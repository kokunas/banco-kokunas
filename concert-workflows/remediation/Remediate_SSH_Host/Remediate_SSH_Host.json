            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"\""
        },
        {
            "name": "metadata_str",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"\""
        },
        {
