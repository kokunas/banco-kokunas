            },
            "value": "[]"
        }
    ],
    "meta": {
        "workerGroup": "default",
        "description": "Remediates OS-package CVEs on a remote Linux host: detects with Trivy (script uploaded via SFTP Put File, invoked via its bare path over Common/SSH, output fetched via SFTP Get File - Class==os-pkgs, FixedVersion present), applies the update and reboots via an Ansible playbook (system/Ansible/Playbook, matching IBM's own Apply_Amazon_Linux_Patch pattern), re-scans to confirm, pushes the result to Concert (official Import Data block, data_type=vm_scan), and closes out any matching native auto_remediation action via the official Action Insights blocks.",
        "layout": "flow",
        "numberOfBlocks": 4,
        "version": 5,
        "tags": [
            {
                "name": "Consumer",
                "value": "Concert"
            },
            {
                "name": "Category",
                "value": "Vulnerability"
            }
        ]
    },
    "finally": null
}