{
    "name": "Remediate_SSH_Host",
    "platform": "node",
    "blocks": [
        {
            "action": "comment",
            "value": "Rebuilt to match IBM's own published remediation pattern (Apply_Amazon_Linux_Patch/Apply_Linux_Patch): detect with Trivy (this repo has no Red Hat/Amazon Linux advisory-sync workflows imported, so Trivy substitutes for that), system/Ansible/Playbook to apply the fix and reboot, and the official Action Insights blocks to close out Concert's native auto_remediation action. Scan steps use SFTP Put/Get File instead of Common/SSH's command field directly, since that field cannot run any multi-word command in this Concert install (confirmed live - see Trivy_SSH_Host_Scan's README for the full bisection)."
        },
        {
            "action": "system/Common/SFTP/SFTP Put File",
            "name": "UploadPreScanScript",
            "inputs": [
                {
                    "name": "authKey",
                    "value": "$ssh_auth"
                },
                {
                    "name": "file",
                    "value": "\"/tmp/trivy_pre_scan.sh\""
                },
                {
                    "name": "contents",
                    "value": "\"#!/bin/bash\\ncommand -v trivy >/dev/null 2>&1 || (curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sudo sh -s -- -b /usr/local/bin v0.72.0)\\nsudo trivy rootfs --scanners vuln --format json --quiet --output /tmp/trivy-pre.json /\\n\""
                },
                {
                    "name": "mode",
                    "value": "\"0755\""
                },
                {
                    "name": "encoding",
                    "value": "\"utf-8\""
                }
            ]
        },
        {
            "action": "while",
            "name": "RetryPreScan",
            "condition": "!$pre_scan_ok && $pre_scan_attempts < 5",
            "blocks": [
                {
                    "action": "system/Common/SSH/SSH",
                    "name": "PreScan",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$ssh_auth"
                        },
                        {
                            "name": "command",
                            "value": "\"/tmp/trivy_pre_scan.sh\"",
                            "type": "const"
                        },
                        {
                            "name": "timeout",
                            "value": "300"
                        }
                    ]
                },
                {
                    "action": "assign",
                    "name": "UpdatePre_scan_ok",
                    "variable": "$pre_scan_ok",
                    "value": "$PreScan.exitcode === 0"
                },
                {
                    "action": "assign",
                    "name": "IncrementPre_scan_attempts",
                    "variable": "$pre_scan_attempts",
                    "value": "$pre_scan_attempts + 1"
                },
                {
                    "action": "if",
                    "name": "IfPreScanFailedSleep",
                    "condition": "!$pre_scan_ok && $pre_scan_attempts < 5",
                    "then": [
                        {
                            "action": "system/Common/Sleep",
                            "name": "WaitBeforeRetryPreScan",
                            "inputs": [
                                {
                                    "name": "seconds",
                                    "value": "5"
                                }
                            ]
                        }
                    ],
                    "else": []
                }
            ]
        },
        {
            "action": "system/Common/SFTP/SFTP Get File",
            "name": "FetchPreScanResult",
            "inputs": [
                {
                    "name": "authKey",
                    "value": "$ssh_auth"
                },
                {
                    "name": "file",
                    "value": "\"/tmp/trivy-pre.json\""
                },
                {
                    "name": "encoding",
                    "value": "\"utf-8\""
                }
            ]
        },
        {
            "name": "ExtractPrePackages",
            "function": "if (!$PreScan.success || $PreScan.exitcode !== 0) {\n    throw new Error(\n        \"PreScan (the trivy_pre_scan.sh invocation) failed (exitcode=\" + $PreScan.exitcode + \", error=\" +\n        $PreScan.error + \") - check that UploadPreScanScript uploaded/marked it executable correctly.\"\n    );\n}\nif (!$FetchPreScanResult.result || !$FetchPreScanResult.result.trim()) {\n    throw new Error(\"FetchPreScanResult (SFTP Get File) returned no content even though PreScan reported success.\");\n}\nconst report = JSON.parse($FetchPreScanResult.result);\nconst found = [];\nfor (const result of (report.Results || [])) {\n    if (result.Class !== \"os-pkgs\") continue;\n    for (const vuln of (result.Vulnerabilities || [])) {\n        if (vuln.FixedVersion) {\n            found.push({id: vuln.VulnerabilityID, pkg: vuln.PkgName});\n        }\n    }\n}\n$pre_vuln_ids = found.map(f => f.id);\n$vulnerable_packages = [...new Set(found.map(f => f.pkg))].sort();\n"
        },
        {
            "action": "if",
            "name": "CheckVulnerablePackagesFound",
            "condition": "$vulnerable_packages.length > 0",
            "then": [
                {
                    "name": "BuildPatchCommand",
                    "function": "$patch_command = \"dnf update -y \" + $vulnerable_packages.join(\" \");\n"
                },
                {
                    "action": "system/Ansible/Playbook",
                    "name": "ApplyUpdates",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$ssh_auth"
                        },
                        {
                            "name": "playbook",
                            "value": "`---\n- name: Apply OS package updates and reboot\n  hosts: canary\n  gather_facts: no\n  become: yes\n  vars:\n    patch_command: \"${$patch_command}\"\n  tasks:\n    - name: Apply package updates\n      shell: \"{{ patch_command }}\"\n      register: patch_result\n      ignore_errors: yes\n\n    - name: Reboot the host if the update succeeded\n      reboot:\n        reboot_timeout: 300\n      when: patch_result.rc == 0\n\n    - name: Record patch outcome\n      set_fact:\n        patch_status:\n          status: \"{{ 'success' if patch_result.rc == 0 else 'failed' }}\"\n          stdout: \"{{ patch_result.stdout | default('') }}\"\n          stderr: \"{{ patch_result.stderr | default('') }}\"`"
                        }
                    ]
                },
                {
                    "action": "system/Common/SFTP/SFTP Put File",
                    "name": "UploadPostScanJsonScript",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$ssh_auth"
                        },
                        {
                            "name": "file",
                            "value": "\"/tmp/trivy_post_scan.sh\""
                        },
                        {
                            "name": "contents",
                            "value": "\"#!/bin/bash\\nsudo trivy rootfs --scanners vuln --format json --quiet --output /tmp/trivy-post.json /\\n\""
                        },
                        {
                            "name": "mode",
                            "value": "\"0755\""
                        },
                        {
                            "name": "encoding",
                            "value": "\"utf-8\""
                        }
                    ]
                },
                {
                    "action": "while",
                    "name": "RetryPostScanJson",
                    "condition": "!$post_scan_ok && $post_scan_attempts < 5",
                    "blocks": [
                        {
                            "action": "system/Common/SSH/SSH",
                            "name": "PostScanJson",
                            "inputs": [
                                {
                                    "name": "authKey",
                                    "value": "$ssh_auth"
                                },
                                {
                                    "name": "command",
                                    "value": "\"/tmp/trivy_post_scan.sh\"",
                                    "type": "const"
                                },
                                {
                                    "name": "timeout",
                                    "value": "300"
                                }
                            ]
                        },
                        {
                            "action": "assign",
                            "name": "UpdatePost_scan_ok",
                            "variable": "$post_scan_ok",
                            "value": "$PostScanJson.exitcode === 0"
                        },
                        {
                            "action": "assign",
                            "name": "IncrementPost_scan_attempts",
                            "variable": "$post_scan_attempts",
                            "value": "$post_scan_attempts + 1"
                        },
                        {
                            "action": "if",
                            "name": "IfPostScanJsonFailedSleep",
                            "condition": "!$post_scan_ok && $post_scan_attempts < 5",
                            "then": [
                                {
                                    "action": "system/Common/Sleep",
                                    "name": "WaitBeforeRetryPostScanJson",
                                    "inputs": [
                                        {
                                            "name": "seconds",
                                            "value": "5"
                                        }
                                    ]
                                }
                            ],
                            "else": []
                        }
                    ]
                },
                {
                    "action": "system/Common/SFTP/SFTP Get File",
                    "name": "FetchPostScanJsonResult",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$ssh_auth"
                        },
                        {
                            "name": "file",
                            "value": "\"/tmp/trivy-post.json\""
                        },
                        {
                            "name": "encoding",
                            "value": "\"utf-8\""
                        }
                    ]
                },
                {
                    "name": "ComparePrePost",
                    "function": "function csvEscape(value) {\n    const str = (value === undefined || value === null) ? \"\" : String(value);\n    return '\"' + str.replace(/\"/g, '\"\"') + '\"';\n}\n\nfunction extractScore(vuln) {\n    const cvss = vuln.CVSS || {};\n    for (const source of Object.keys(cvss)) {\n        const entry = cvss[source] || {};\n        if (typeof entry.V3Score === \"number\") return entry.V3Score;\n        if (typeof entry.V2Score === \"number\") return entry.V2Score;\n    }\n    return \"\";\n}\n\nif (!$PostScanJson.success || $PostScanJson.exitcode !== 0) {\n    throw new Error(\n        \"PostScanJson (the trivy_post_scan.sh invocation) failed (exitcode=\" + $PostScanJson.exitcode +\n        \", error=\" + $PostScanJson.error + \") - check that UploadPostScanScript uploaded/marked it executable correctly.\"\n    );\n}\nif (!$FetchPostScanResult.result || !$FetchPostScanResult.result.trim()) {\n    throw new Error(\"FetchPostScanResult (SFTP Get File) returned no content even though PostScanJson reported success.\");\n}\nconst postReport = JSON.parse($FetchPostScanResult.result);\nconst postFixableIds = [];\nconst csvRows = [];\nconst header = [\"CVE\", \"Host IPAddress\", \"Package\", \"Package Version\", \"Package Path\", \"severity\", \"Score\", \"hasFix\", \"Fixed Version\", \"Description\", \"Host Name\"];\ncsvRows.push(header.map(csvEscape).join(\",\"));\n\nfor (const result of (postReport.Results || [])) {\n    if (result.Class !== \"os-pkgs\") continue;\n    for (const vuln of (result.Vulnerabilities || [])) {\n        if (vuln.FixedVersion) {\n            postFixableIds.push(vuln.VulnerabilityID);\n        }\n        csvRows.push([\n            vuln.VulnerabilityID,\n            $target_host,\n            vuln.PkgName,\n            vuln.InstalledVersion,\n            \"\",\n            (vuln.Severity || \"\").toLowerCase(),\n            extractScore(vuln),\n            vuln.FixedVersion ? \"Y\" : \"N\",\n            vuln.FixedVersion || \"\",\n            vuln.Description,\n            $target_host\n        ].map(csvEscape).join(\",\"));\n    }\n}\n\nconst postIds = new Set(postFixableIds);\n$resolved_ids = $pre_vuln_ids.filter(id => !postIds.has(id));\n$still_present_ids = $pre_vuln_ids.filter(id => postIds.has(id));\n$remediation_ok = $still_present_ids.length === 0;\n\n$vm_scan_csv = csvRows.join(\"\\n\");\n$metadata_str = JSON.stringify({scanner_name: \"concert\"});\n"
                },
                {
                    "action": "system/IBM/Concert v2/Import Data/Upload Files to Concert",
                    "name": "IngestPostScan",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$concert_auth"
                        },
                        {
                            "name": "file",
                            "value": "{\n    \"data_type\": \"vm_scan\",\n    \"metadata\": $metadata_str,\n    \"filename\": $vm_scan_csv\n}"
                        },
                        {
                            "name": "fileType",
                            "value": "\"csv\""
                        }
                    ]
                },
                {
                    "action": "system/IBM/Concert v2/Action Insights/Search in Actions",
                    "name": "FindActions",
                    "inputs": [
                        {
                            "name": "authKey",
                            "value": "$concert_auth"
                        },
                        {
                            "name": "Body",
                            "value": "{\n    \"filters\": {\n        \"logic\": \"and\",\n        \"conditions\": [\n            {\n                \"field\": \"application_name\",\n                \"value\": $application_name,\n                \"operator\": \"=\"\n            },\n            {\n                \"field\": \"action_category\",\n                \"value\": \"auto_remediation\",\n                \"operator\": \"=\"\n            },\n            {\n                \"field\": \"status\",\n                \"value\": \"created\",\n                \"operator\": \"=\"\n            }\n        ]\n    },\n    \"pagination\": {\n        \"page\": 1,\n        \"page_size\": 100\n    }\n}"
                        }
                    ]
                },
                {
                    "name": "BuildActionUpdates",
                    "function": "const found = ($FindActions.result && $FindActions.result.actions) || [];\n$action_updates = found.map(a => ({\n    action_id: a.actions_identifier,\n    status: $remediation_ok ? \"success\" : \"failed\",\n    comments: \"Auto-updated by Remediate_SSH_Host\"\n}));\n"
                },
                {
                    "action": "if",
                    "name": "CheckActionsFound",
                    "condition": "$action_updates.length > 0",
                    "then": [
                        {
                            "action": "system/IBM/Concert v2/Action Insights/Update Existing Action",
                            "name": "MarkActions",
                            "inputs": [
                                {
                                    "name": "authKey",
                                    "value": "$concert_auth"
                                },
                                {
                                    "name": "Body",
                                    "value": "{\n    \"actions\": $action_updates\n}"
                                }
                            ]
                        }
                    ],
                    "else": []
                },
                {
                    "action": "assign",
                    "name": "SetResultSuccess",
                    "variable": "$result",
                    "value": "\"Packages updated: \" + $vulnerable_packages.join(\", \") + \" | Resolved: \" + $resolved_ids.join(\", \") + \" | Still present: \" + $still_present_ids.join(\", \") + \" | Overall: \" + ($remediation_ok ? \"OK\" : \"ACTION NEEDED\")"
                }
            ],
            "else": [
                {
                    "action": "assign",
                    "name": "SetResultNothingToDo",
                    "variable": "$result",
                    "value": "\"No OS packages with a known fix were found - nothing to remediate.\""
                }
            ]
        }
    ],
    "variables": [
        {
            "name": "result",
            "required": false,
            "isInput": false,
            "isOutput": true,
            "level": "INTERMEDIATE",
            "type": {
                "type": "any"
            },
            "value": "\"\""
        },
        {
            "name": "ssh_auth",
            "required": true,
            "isInput": true,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "any"
            },
            "value": "\"\"",
            "meta": {
                "authType": "ANY",
                "subType": "authentication",
                "description": "Common/SSH credential stored in Concert for the target host - also used as the Ansible playbook's authKey (same credential works for both, per IBM's own Test_Connection_to_RHEL/Apply_Amazon_Linux_Patch examples)."
            }
        },
        {
            "name": "concert_auth",
            "required": true,
            "isInput": true,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "any"
            },
            "value": "\"\"",
            "meta": {
                "authType": "ANY",
                "subType": "authentication",
                "description": "Stored Concert API credential, same one used by Import Data / Action Insights blocks."
            }
        },
        {
            "name": "application_name",
            "required": false,
            "isInput": true,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"amazon-linux-demo\""
        },
        {
            "name": "application_version",
            "required": false,
            "isInput": true,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"1.0.0\""
        },
        {
            "name": "target_host",
            "required": true,
            "isInput": true,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"\"",
            "meta": {
                "description": "IP address or hostname of the target - populates the Host IPAddress/Host Name columns in the vm_scan CSV so Concert attributes these CVEs to this specific host."
            }
        },
        {
            "name": "pre_scan_ok",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "boolean"
            },
            "value": "false"
        },
        {
            "name": "pre_scan_attempts",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "number"
            },
            "value": "0"
        },
        {
            "name": "post_scan_ok",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "boolean"
            },
            "value": "false"
        },
        {
            "name": "post_scan_attempts",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "number"
            },
            "value": "0"
        },
        {
            "name": "pre_vuln_ids",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "array"
            },
            "value": "[]"
        },
        {
            "name": "vulnerable_packages",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "array"
            },
            "value": "[]"
        },
        {
            "name": "patch_command",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "string"
            },
            "value": "\"\""
        },
        {
            "name": "resolved_ids",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "array"
            },
            "value": "[]"
        },
        {
            "name": "still_present_ids",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "array"
            },
            "value": "[]"
        },
        {
            "name": "remediation_ok",
            "required": false,
            "isInput": false,
            "isOutput": false,
            "level": "INTERMEDIATE",
            "type": {
                "type": "boolean"
            },
            "value": "false"
        },
        {
